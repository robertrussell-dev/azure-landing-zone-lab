# Copy to terraform.tfvars and fill in. terraform.tfvars is gitignored.

tenant_id       = "00000000-0000-0000-0000-000000000000"
subscription_id = "00000000-0000-0000-0000-000000000000"

# Everything in this directory is created here. sub-connectivity is in the
# vending map in 20-subscription-placement but is not created by default.
connectivity_subscription_id = "00000000-0000-0000-0000-000000000000"

location = "westus2"

# The free layer. Virtual networks, subnets, peerings, network security groups
# and route tables cost nothing at rest, so these can stay deployed.
hub_address_space = "10.0.0.0/20"

# ---------------------------------------------------------------------------
# Everything below bills by the hour. All default to false.
# ---------------------------------------------------------------------------
# Approximate standing cost, retail West US 2 USD, before data processing:
#
#   deploy_firewall             Standard  about 912 per month   (Basic: 288)
#   deploy_bastion              Standard  about 212 per month
#   deploy_vpn_gateway          VpnGw1    about 139 per month
#   deploy_expressroute_gateway Standard  about 139 per month
#   deploy_route_server                   about  73 per month
#
# All five plus their public IPs is 1,495 per month. Turn one on, get what you
# needed, turn it off the same day.

deploy_firewall             = false
firewall_sku_tier           = "Standard"
deploy_bastion              = false
deploy_vpn_gateway          = false
deploy_expressroute_gateway = false
deploy_route_server         = false

# A budget on the connectivity subscription. Leave the list empty to skip it.
budget_alert_emails   = ["you@example.com"]
monthly_budget_amount = 50
