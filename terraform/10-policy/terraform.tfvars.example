# Copy to terraform.tfvars and fill in. terraform.tfvars is gitignored.

tenant_id       = "00000000-0000-0000-0000-000000000000"
subscription_id = "00000000-0000-0000-0000-000000000000"
prefix          = "contoso"
location        = "westus2"

# Leave null until the Log Analytics workspace exists in the management
# subscription. The DeployIfNotExists assignment is skipped while it is null.
# log_analytics_workspace_id = "/subscriptions/.../workspaces/law-management"
