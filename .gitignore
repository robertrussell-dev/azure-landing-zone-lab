# Terraform state. Never commit. State can contain resource IDs and secrets.
*.tfstate
*.tfstate.*
.terraform/
.terraform.tfstate.lock.info
crash.log
crash.*.log

# Variable files may contain tenant and subscription IDs specific to one operator.
*.tfvars
*.auto.tfvars
!*.tfvars.example

# The dependency lock file IS committed on purpose, so provider versions are
# reproducible for anyone who clones this repo.
!.terraform.lock.hcl

# Bicep parameter files, for the same reason as tfvars: they carry one
# operator's tenant, subscription and billing IDs. The committed examples end
# in .example.bicepparam, which also makes them real parameter files that CI
# compiles against their templates rather than untested sample text.
*.bicepparam
!*.example.bicepparam

# Compiled ARM JSON. Bicep is the source; a committed build output is one more
# thing to keep in step and the first thing to go stale.
bicep/**/*.json
!bicep/bicepconfig.json

# Local editor and OS noise
.vscode/
.DS_Store
Thumbs.db

# Saved plan files. Binary, and they can contain resource values that were
# never meant to leave the machine that produced them.
tfplan
*.tfplan
tfplan.*

# Local working notes, not part of the published repo.
landing-zone-lab-brief.md
decisions.md

# Pinned tooling installed by scripts/install-*.sh
.tools/
