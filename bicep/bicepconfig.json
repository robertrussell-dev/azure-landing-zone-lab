{
  // Bicep linter configuration.
  //
  // A rule turned off says why, as in .checkov.yml. lint-bicep.sh fails on any
  // output, so severities don't matter. Below: rules that ship disabled and are
  // turned on, and two left off.
  "analyzers": {
    "core": {
      "enabled": true,
      "verbose": false,
      "rules": {
        // A location baked into a resource cannot be overridden by a caller,
        // and every resource in this tree is meant to be redeployable to
        // another region.
        "no-hardcoded-location": {
          "level": "error"
        },

        // resourceGroup().location and deployment().location outside a
        // parameter default make the region depend on where the deployment
        // happened to be run from.
        "no-loc-expr-outside-params": {
          "level": "error"
        },

        // Quoted property names are legal and occasionally required, for
        // example 'lz-corp-audit'. This flags the ones that are not.
        "prefer-unquoted-property-names": {
          "level": "error"
        },

        // Catches a value that reaches a @secure() parameter without being
        // secure itself. Nothing here handles secrets yet, and the rule costs
        // nothing until something does.
        "use-secure-value-for-secure-inputs": {
          "level": "error"
        }

        // Left off:
        //
        // explicit-values-for-loc-params. It fires on every Audit and Deny call
        // to modules/policy-assignment, where location is unused.
        //
        // use-recent-api-versions. Everything passes it today, but it would fail
        // the build 730 days after a version was pinned, with no change made.
        // Run it by hand when reviewing.
      }
    }
  }
}
